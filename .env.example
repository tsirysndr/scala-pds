# Copy to .env and edit. Nothing here is required for a development server:
# with no variables set, scala-pds stores everything in data/scala-pds.sqlite3
# and generates data/master.key on first start.
#
# See docs/configuration.md for the full reference.

# --- Server -----------------------------------------------------------------
# PDS_HOST=127.0.0.1
# PDS_PORT=3000
# PDS_HOSTNAME=pds.example.com
# Canonical origin clients reach: lowercase host, no path, no default port.
# PDS_PUBLIC_URL=https://pds.example.com
# The suffix account handles must end with; defaults to PDS_HOSTNAME.
# PDS_USER_DOMAIN=pds.example.com
# PDS_RATE_LIMIT_PER_MINUTE=300
# How far back subscribeRepos can rewind; 0 keeps every event forever.
# PDS_FIREHOSE_RETENTION_HOURS=72

# --- Secrets ----------------------------------------------------------------
# Generate ONCE and keep it; losing it makes stored signing keys unreadable:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
# PDS_MASTER_KEY=
# At least 12 characters. Enables the com.atproto.admin.* methods.
# PDS_ADMIN_PASSWORD=

# --- Identity ---------------------------------------------------------------
# 'plc' or 'web'; defaults to 'web' on a loopback hostname.
# PDS_DID_METHOD=plc
# PDS_PLC_DIRECTORY=https://plc.directory

# --- Signup policy ----------------------------------------------------------
# PDS_SIGNUP_ENABLED=true
# PDS_INVITE_REQUIRED=false

# --- Storage ----------------------------------------------------------------
# SQLite is used when no PDS_DATABASE_* variable is set.
# PDS_SQLITE_PATH=data/scala-pds.sqlite3
#
# Setting any of these selects PostgreSQL and requires all three.
# PDS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/pds
# PDS_DATABASE_USER=pds
# PDS_DATABASE_PASSWORD=
# PDS_DATABASE_POOL_SIZE=10

# --- Services ---------------------------------------------------------------
# PDS_APPVIEW_URL=https://api.bsky.app
# PDS_APPVIEW_DID=did:web:api.bsky.app
# Comma-separated relays asked to crawl this host at startup.
# PDS_RELAY_URLS=https://bsky.network
# PDS_BLOB_MAX_SIZE=5242880

# --- Blob storage -----------------------------------------------------------
# Setting a bucket moves blobs out of the database; region and both
# credentials are then required.
# PDS_S3_BUCKET=
# PDS_S3_REGION=us-east-1
# PDS_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# PDS_S3_ACCESS_KEY_ID=
# PDS_S3_SECRET_ACCESS_KEY=
# PDS_S3_PATH_STYLE=true

# --- Email ------------------------------------------------------------------
# An HTTPS endpoint that receives {to, from, purpose, token} as JSON.
# PDS_EMAIL_ENDPOINT=https://mail.example.workers.dev/send
# PDS_EMAIL_TOKEN=
# PDS_EMAIL_FROM=noreply@pds.example.com

# --- Server description -----------------------------------------------------
# PDS_CONTACT_EMAIL=admin@example.com
# PDS_PRIVACY_POLICY_URL=https://example.com/privacy
# PDS_TERMS_OF_SERVICE_URL=https://example.com/terms

# --- Development only -------------------------------------------------------
# Allows outbound fetches to private address space on an HTTPS server.
# PDS_ALLOW_PRIVATE_NETWORK=false
